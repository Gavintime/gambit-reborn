    "version": "0.2.0",
    "configurations": [
        {
            "name": "Attach to express-app",
            "type": "node",
            "request": "attach",
            "address": "localhost",
            "port": 9229,
            "localRoot": "${workspaceRoot}",
            "remoteRoot": "${workspaceRoot}",
            "skipFiles": [
                // Node.js internal core modules
                "<node_internals>/**",
        
                // Ignore all dependencies (optional)
                "${workspaceFolder}/node_modules/**",
            ]
        }
    ]
}