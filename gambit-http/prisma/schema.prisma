// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement()) @db.UnsignedInt
  createdAt    DateTime @default(now())
  name         String   @unique @db.VarChar(12)
  gamesAsWhite Game[]   @relation("white")
  gamesAsBlack Game[]   @relation("black")
}

// immutable finished games, in progress games are store in redis (maybe in the future allow long form games that are stored in this db)
model Game {
  id         Int        @id @default(autoincrement()) @db.UnsignedInt
  createdAt  DateTime
  finishedAt DateTime
  result     GameResult
  plyCount   Int        @db.UnsignedSmallInt
  white      User       @relation("white", fields: [whiteId], references: [id])
  whiteId    Int        @db.UnsignedInt
  black      User       @relation("black", fields: [blackId], references: [id])
  blackId    Int        @db.UnsignedInt
  moves      String     @db.Text
}

// TODO: revisit once timers are added
enum GameResult {
  WHITE_WON
  BLACK_WON
  // forced tie, agree to draw, etc
  TIE
}
